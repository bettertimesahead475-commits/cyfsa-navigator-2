# GEMINI_API_KEY: Server-only Google Gemini API credential used by /api/analyzer/* routes.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SUPABASE_URL: Authoritative CYFSA Navigator Supabase project URL (server target).
SUPABASE_URL="https://cyfsanavigator-prod.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: Server-only privileged credential matching SUPABASE_URL project ref.
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# FIREBASE_PROJECT_ID: Authoritative Firebase project ID (configured with Google Client).
FIREBASE_PROJECT_ID="gen-lang-client-0105737183"

# VITE_FIREBASE_PROJECT_ID: Client-side Firebase project identifier.
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0105737183"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://cyfsanavigator.com"
